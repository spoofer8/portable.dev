{
  "expo": {
    "name": "Portable",
    "slug": "portable-mobile",
    "version": "3.5.4",
    "orientation": "portrait",
    "scheme": "portable",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/images/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "cloud.umair.portable",
      "appleTeamId": "37A9CY6R6P",
      "googleServicesFile": "./GoogleService-Info.plist",
      "icon": {
        "light": "./assets/images/icon.png",
        "dark": "./assets/images/icon-dark.png"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSSupportsLiveActivities": true,
        "NSSpeechRecognitionUsageDescription": "Portable transcribes your speech so you can dictate messages — on-device by default, or off-device when on-device recognition isn't available or you choose Cloud mode.",
        "NSMicrophoneUsageDescription": "Portable uses the microphone so you can dictate messages."
      },
      "runtimeVersion": {
        "policy": "fingerprint"
      }
    },
    "android": {
      "package": "dev.portable.app",
      "googleServicesFile": "./google-services.json",
      "edgeToEdgeEnabled": true,
      "permissions": ["android.permission.RECORD_AUDIO", "android.permission.CAMERA"],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#F7F3DF"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Portable accesses your photos so you can attach images to a chat."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Portable uses the camera so you can capture a photo to attach to a chat."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Portable uses the microphone so you can dictate messages.",
          "speechRecognitionPermission": "Portable transcribes your speech so you can dictate messages — on-device by default, or off-device when on-device recognition isn't available or you choose Cloud mode.",
          "androidSpeechServicePackages": ["com.google.android.googlequicksearchbox"]
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#6366f1",
          "androidMode": "default",
          "androidCollapsedTitle": "Portable"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon-light.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "dark": {
            "image": "./assets/images/splash-icon-dark.png",
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "note": "Use SENTRY_AUTH_TOKEN from the build environment. Never put the token here.",
          "organization": "osama-org",
          "project": "portable-mobile-s3"
        }
      ],
      "@bacons/apple-targets",
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      "./plugins/withModularHeaders",
      "./plugins/withIosSceneLifecycle"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "bundleIdentifier": "cloud.umair.portable.widget",
                  "targetName": "ClaudeWidgets"
                }
              ]
            }
          }
        },
        "projectId": "114bef50-b96c-4db6-9c47-3c610bcdf321"
      }
    },
    "owner": "spo0fer",
    "updates": {
      "url": "https://u.expo.dev/114bef50-b96c-4db6-9c47-3c610bcdf321",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
